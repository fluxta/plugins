{
  "actions": [
    {
      "name": "Send Twitch Chat Message",
      "type": "send-message",
      "icon": "icons/message-circle.svg",
      "context": "standalone",
      "editor": "editor/send-message.html"
    },
    {
      "name": "Update Twitch Reward",
      "type": "twitch-update-reward",
      "icon": "icons/gift.svg",
      "context": "standalone",
      "editor": "editor/update-reward.html"
    },
    {
      "name": "Resolve Twitch Redemption",
      "type": "twitch-resolve-redemption",
      "icon": "icons/check-check.svg",
      "context": "standalone",
      "editor": "editor/resolve-redemption.html"
    },
    {
      "name": "Start Twitch Poll",
      "type": "twitch-start-poll",
      "icon": "icons/vote.svg",
      "context": "standalone",
      "editor": "editor/start-poll.html",
      "produces": [
        {
          "key": "pollId",
          "name": "Poll ID",
          "type": "string"
        }
      ]
    },
    {
      "name": "End Twitch Poll",
      "type": "twitch-end-poll",
      "icon": "icons/flag.svg",
      "context": "standalone"
    },
    {
      "name": "Start Twitch Prediction",
      "type": "twitch-start-prediction",
      "icon": "icons/target.svg",
      "context": "standalone",
      "editor": "editor/start-prediction.html",
      "produces": [
        {
          "key": "predictionId",
          "name": "Prediction ID",
          "type": "string"
        }
      ]
    },
    {
      "name": "Lock Twitch Prediction",
      "type": "twitch-lock-prediction",
      "icon": "icons/lock.svg",
      "context": "standalone"
    },
    {
      "name": "Resolve Twitch Prediction",
      "type": "twitch-resolve-prediction",
      "icon": "icons/trophy.svg",
      "context": "standalone",
      "editor": "editor/resolve-prediction.html"
    },
    {
      "name": "Cancel Twitch Prediction",
      "type": "twitch-cancel-prediction",
      "icon": "icons/circle-x.svg",
      "context": "standalone"
    }
  ],
  "sources": [
    {
      "key": "twitchIsLive",
      "name": "Twitch Is Live",
      "type": "boolean",
      "resolve": "query"
    },
    {
      "key": "twitchViewerCount",
      "name": "Twitch Viewer Count",
      "type": "number",
      "resolve": "query"
    }
  ],
