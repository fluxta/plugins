  ],
  "sources": [
    {
      "key": "isStreaming",
      "name": "Is Streaming",
      "type": "boolean",
      "resolve": "query",
      "params": [
        { "key": "connection", "name": "Connection", "editor": "select", "options": "connections" }
      ]
    },
    {
      "key": "isRecording",
      "name": "Is Recording",
      "type": "boolean",
      "resolve": "query",
      "params": [
        { "key": "connection", "name": "Connection", "editor": "select", "options": "connections" }
      ]
    },
    {
      "key": "isRecordingPaused",
      "name": "Is Recording Paused",
      "type": "boolean",
      "resolve": "query",
      "params": [
        { "key": "connection", "name": "Connection", "editor": "select", "options": "connections" }
      ]
    },
    {
      "key": "currentScene",
      "name": "Current Scene",
      "type": "string",
      "resolve": "query",
      "params": [
        { "key": "connection", "name": "Connection", "editor": "select", "options": "connections" }
      ],
      "operand": { "editor": "select", "options": "scenes" }
    },
    {
      "key": "isSourceVisible",
      "name": "Is Source Visible",
      "type": "boolean",
      "resolve": "query",
      "params": [
        { "key": "connection", "name": "Connection", "editor": "select", "options": "connections" },
        { "key": "sceneName", "name": "Scene", "editor": "select", "options": "scenes" },
        { "key": "sourceName", "name": "Source", "editor": "select", "options": "scene-sources" }
      ]
    },
    {
      "key": "isInputMuted",
      "name": "Is Input Muted",
      "type": "boolean",
      "resolve": "query",
      "params": [
        { "key": "connection", "name": "Connection", "editor": "select", "options": "connections" },
        { "key": "inputName", "name": "Input", "editor": "select", "options": "inputs" }
      ]
    },
    {
      "key": "inputVolume",
      "name": "Input Volume",
      "type": "number",
      "resolve": "query",
      "params": [
        { "key": "connection", "name": "Connection", "editor": "select", "options": "connections" },
        { "key": "inputName", "name": "Input", "editor": "select", "options": "inputs" }
      ]
    },
    {
      "key": "isFilterEnabled",
      "name": "Is Filter Enabled",
      "type": "boolean",
      "resolve": "query",
      "params": [
        { "key": "connection", "name": "Connection", "editor": "select", "options": "connections" },
        { "key": "sourceName", "name": "Source", "editor": "select", "options": "inputs" },
        { "key": "filterName", "name": "Filter", "editor": "select", "options": "filters" }
      ]
    }
  ],
  "apiVersion": 1,
  "author": "Mikhail Morozov",
  "description": "Control OBS Studio",
  "editor": "editor/plugin.html",
  "editorPlacement": "settings",
  "homepage": "https://github.com/inferst/fluxta-obs",
  "icon": "icons/video.svg",
  "license": "MIT",
  "main": "index.mjs",
  "maintainers": ["inferst"],
  "minAppVersion": "0.1.0",
  "name": "obs",
  "repository": "https://github.com/inferst/fluxta-obs",
  "title": "OBS",
  "version": "0.4.2",
  "events": [
    {
      "type": "scene-changed",
      "name": "Scene Changed",
      "fields": [
        {
          "key": "connection",
          "name": "Connection",
          "type": "string",
          "operand": { "editor": "select", "options": "connections" }
        },
        {
          "key": "sceneName",
          "name": "Scene Name",
          "type": "string",
          "operand": { "editor": "select", "options": "scenes" }
        }
      ]
    },
    {
      "type": "stream-state-changed",
      "name": "Stream State Changed",
      "fields": [
        {
          "key": "connection",
          "name": "Connection",
          "type": "string",
          "operand": { "editor": "select", "options": "connections" }
        },
        { "key": "isStreaming", "name": "Is Streaming", "type": "boolean" }
      ]
    },
    {
      "type": "record-state-changed",
      "name": "Record State Changed",
      "fields": [
        {
          "key": "connection",
          "name": "Connection",
          "type": "string",
          "operand": { "editor": "select", "options": "connections" }
        },
        { "key": "isRecording", "name": "Is Recording", "type": "boolean" },
        { "key": "isRecordingPaused", "name": "Is Recording Paused", "type": "boolean" }
      ]
    },
    {
      "type": "source-visibility-changed",
      "name": "Source Visibility Changed",
      "fields": [
        {
          "key": "connection",
          "name": "Connection",
          "type": "string",
          "operand": { "editor": "select", "options": "connections" }
        },
        {
          "key": "sceneName",
          "name": "Scene Name",
          "type": "string",
          "operand": { "editor": "select", "options": "scenes" }
        },
        {
          "key": "sourceName",
          "name": "Source Name",
          "type": "string",
          "operand": { "editor": "select", "options": "scene-sources" }
        },
        { "key": "visible", "name": "Visible", "type": "boolean" }
      ]
    },
    {
      "type": "input-mute-changed",
      "name": "Input Mute Changed",
      "fields": [
        {
          "key": "connection",
          "name": "Connection",
          "type": "string",
          "operand": { "editor": "select", "options": "connections" }
        },
        {
          "key": "inputName",
          "name": "Input Name",
          "type": "string",
          "operand": { "editor": "select", "options": "inputs" }
        },
        { "key": "muted", "name": "Muted", "type": "boolean" }
      ]
    },
    {
      "type": "source-filter-enabled-changed",
      "name": "Source Filter Enabled Changed",
      "fields": [
        {
          "key": "connection",
          "name": "Connection",
          "type": "string",
          "operand": { "editor": "select", "options": "connections" }
        },
        {
          "key": "sourceName",
          "name": "Source Name",
          "type": "string",
          "operand": { "editor": "select", "options": "inputs" }
        },
        {
          "key": "filterName",
          "name": "Filter Name",
          "type": "string",
          "operand": { "editor": "select", "options": "filters" }
        },
        { "key": "enabled", "name": "Enabled", "type": "boolean" }
      ]
    },
    {
      "type": "scene-filter-enabled-changed",
      "name": "Scene Filter Enabled Changed",
      "fields": [
        {
          "key": "connection",
          "name": "Connection",
          "type": "string",
          "operand": { "editor": "select", "options": "connections" }
        },
        {
          "key": "sceneName",
          "name": "Scene Name",
          "type": "string",
          "operand": { "editor": "select", "options": "scenes" }
        },
        {
          "key": "filterName",
          "name": "Filter Name",
          "type": "string",
          "operand": { "editor": "select", "options": "scene-filters" }
        },
        { "key": "enabled", "name": "Enabled", "type": "boolean" }
      ]
    },
    {
      "type": "connection-status-changed",
      "name": "Connection Status Changed",
      "fields": [
        {
          "key": "connection",
          "name": "Connection",
          "type": "string",
          "operand": { "editor": "select", "options": "connections" }
        },
        {
          "key": "status",
          "name": "Status",
          "type": "string",
          "operand": { "editor": "select", "options": "connection-status" }
        },
        {
          "key": "message",
          "name": "Message",
          "type": "string"
        }
      ]
    }
  ]
}
